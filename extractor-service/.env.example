# Server
PORT=8080

# Auth (share with OpenClaw client running tally-skill)
EXTRACTOR_BEARER=

# Codex CLI (must be logged in: codex login --device-code)
CODEX_BIN=codex
CODEX_MODEL=gpt-5
# Max wait per extraction (ms); increase if invoices are slow
CODEX_TIMEOUT_MS=300000
# Headless PM2: if exec stalls on approvals, uncomment:
# CODEX_EXTRA_ARGS=--dangerously-bypass-approvals-and-sandbox

# PDF to PNG (poppler-utils: sudo apt install poppler-utils)
PDFTOPPM_BIN=pdftoppm
MAX_PAGES=10

# Temp uploads and idempotency cache
UPLOAD_DIR=./uploads
IDEMPOTENCY_CACHE_DIR=./data

# Max upload size in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760
